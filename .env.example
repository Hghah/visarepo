# Copy to .env and adjust. Docker Compose reads this file; the defaults in docker-compose.yml work without it.

# --- PostgreSQL ---
POSTGRES_USER=stamped
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stamped
DB_PORT=5432

# --- API (NestJS) ---
API_PORT=4000
# For running the API outside Docker (pnpm dev), point at the database above:
DATABASE_URL=postgres://stamped:change-me@localhost:5432/stamped
DATABASE_POOL_MAX=10
# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
SWAGGER_ENABLED=true
LOG_LEVEL=log
# always | if-stale | never. if-stale reloads the data set only when a release ships a new version.
SEED_MODE=if-stale

# --- Shared secret: the web server sends it so its API calls skip the per-IP rate limit (min 16 chars) ---
INTERNAL_API_TOKEN=replace-with-a-long-random-string

# --- Web (Next.js) ---
WEB_PORT=3000
# Where the Next.js server reaches the API (server-side only, never sent to browsers).
API_URL=http://localhost:4000
# Public URL of the site, used in the sitemap, robots.txt and canonical links. Baked in at build time.
SITE_URL=http://localhost:3000

# Image tag used by docker compose.
TAG=local
